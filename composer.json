{
  "name": "backup-pilot/backup-pilot",
  "description": "WordPress backup, restore, and migration plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Yousef Amer",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/joexamer/backup-pilot/issues",
    "source": "https://github.com/joexamer/backup-pilot"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "test": "phpunit -c tests/phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
